{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audio2txt",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "stt.chinamed.tech", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    // 每个用户每分钟最多 30 个分段请求（约 30 分钟音频）
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "HF_SPACE_URL": "https://chellen021-audio2txt-whisper.hf.space",
    // Clerk 发布密钥（可以公开），由 Worker 注入页面；本地开发在 .dev.vars 里覆盖成 pk_test_
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuY2hpbmFtZWQudGVjaCQ"
  },
  "observability": { "enabled": true }
}
